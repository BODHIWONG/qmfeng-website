# Native Zoho CRM consultation integration (server-side only)
# Use the Zoho Accounts and API domains for the CRM data centre where the organisation is hosted.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CRM_API_VERSION=v8

# Confirmed standard CRM module for consultation enquiries.
ZOHO_CRM_MODULE_API_NAME=Leads

# Required OAuth scopes:
# ZohoCRM.modules.leads.READ
# ZohoCRM.modules.leads.CREATE
# ZohoCRM.modules.leads.UPDATE
# ZohoSearch.securesearch.READ

# Standard field API names. Leave custom-field mappings blank until confirmed in Zoho.
ZOHO_CRM_FIELD_MAP_JSON={"name":"Last_Name","phone":"Phone","email":"Email","message":"Description","leadSource":"Lead_Source","consultationType":"","submissionId":"","pageUrl":""}

# Map website lead-source values to the exact existing Zoho picklist values.
ZOHO_CRM_LEAD_SOURCE_MAP_JSON={"Google Ads":"Google Ads","Organic Search":"Organic Search","Website":"Website","Facebook":"Facebook","Instagram":"Instagram","TikTok":"TikTok","LinkedIn":"LinkedIn","Referral":"Referral","Walk-in":"Walk-in","Existing Client":"Existing Client","Other":"Other"}

# Optional defaults for NEW Leads only. Example:
# ZOHO_CRM_STATIC_FIELDS_JSON={"Company":"Website Enquiry"}
# Static fields are never applied when updating an existing record.
ZOHO_CRM_STATIC_FIELDS_JSON={}

# Optional existing layout and lead-assignment rule IDs.
ZOHO_CRM_LAYOUT_ID=
ZOHO_CRM_ASSIGNMENT_RULE_ID=

# Optional Zoho automation triggers. Example after CRM-owner confirmation: ["workflow"]
ZOHO_CRM_TRIGGERS_JSON=

# Optional Google Ads conversion target for confirmed native form submissions.
# Format: AW-XXXXXXXXXXX/CONVERSION_LABEL
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION_SEND_TO=

# Temporary HTTPS POST fallback used only when native Zoho configuration is absent.
QIMEN_LEADS_WEBHOOK_URL=
APPOINTMENT_WEBHOOK_URL=

# Existing course-registration workflow. This remains separate from consultation CRM integration.
COURSE_REGISTRATION_WEBHOOK_URL=
COURSE_ADMIN_EMAIL=info@qmfeng.com
COURSE_EMAIL_FROM=Qimen Strategy <registration@qmfeng.com>
COURSE_REPLY_TO=info@qmfeng.com
RESEND_API_KEY=
