# Native Zoho CRM consultation integration (server-side only)
# Use the Zoho Accounts domain for the CRM data centre where the organisation is hosted.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CRM_API_VERSION=v8

# Existing CRM module API name. Examples only: Leads, Contacts, or an existing custom module API name.
# Confirm this in Zoho CRM Setup > Developer Space > APIs > API Names.
ZOHO_CRM_MODULE_API_NAME=

# Map website concepts to the existing Zoho field API names.
# Empty values omit optional fields. Do not use field labels; use API names.
ZOHO_CRM_FIELD_MAP_JSON={"name":"Last_Name","phone":"Phone","email":"Email","message":"Description","leadSource":"Lead_Source","consultationType":"","submissionId":"","pageUrl":""}

# Map website lead-source values to the exact existing Zoho picklist values.
ZOHO_CRM_LEAD_SOURCE_MAP_JSON={"Google Ads":"Google Ads","Organic Search":"Organic Search","Website":"Website","Facebook":"Facebook","Instagram":"Instagram","TikTok":"TikTok","LinkedIn":"LinkedIn","Referral":"Referral","Walk-in":"Walk-in","Existing Client":"Existing Client","Other":"Other"}

# Existing mandatory/default CRM fields that are not collected from the first enquiry.
# Example for a standard Leads module only; confirm the actual mandatory fields before using:
# ZOHO_CRM_STATIC_FIELDS_JSON={"Company":"Website Enquiry"}
ZOHO_CRM_STATIC_FIELDS_JSON={}

# Optional existing layout and lead-assignment rule IDs. Leave blank when not used.
ZOHO_CRM_LAYOUT_ID=
ZOHO_CRM_ASSIGNMENT_RULE_ID=

# Optional Google Ads conversion target for successful native form submissions.
# Format: AW-XXXXXXXXXXX/CONVERSION_LABEL
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION_SEND_TO=

# Existing consultation webhook retained only as a safe fallback while Zoho is not configured.
QIMEN_LEADS_WEBHOOK_URL=
APPOINTMENT_WEBHOOK_URL=

# Existing course-registration workflow. This remains separate from the consultation CRM integration.
COURSE_REGISTRATION_WEBHOOK_URL=
COURSE_ADMIN_EMAIL=info@qmfeng.com
COURSE_EMAIL_FROM=Qimen Strategy <registration@qmfeng.com>
COURSE_REPLY_TO=info@qmfeng.com
RESEND_API_KEY=
